<?xml version="1.0" encoding="utf-8"?>
<!-- 行の表面から「削除」を隠蔽し、長押しでのみ現れるクイックメニュー。
     誤爆防止のため、削除だけ警告色で少し離して配置する。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/sheet_preview_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/action_toggle_pin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_push_pin_16" />
        <TextView
            android:id="@+id/action_toggle_pin_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="ピン留めする"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/action_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_edit_24" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="編集する"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/action_delete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">
        <ImageView
            android:id="@+id/action_delete_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_delete_24" />
        <TextView
            android:id="@+id/action_delete_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="削除する"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
