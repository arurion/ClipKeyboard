<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ime_root"
    android:layout_width="match_parent"
    android:layout_height="244dp">

    <LinearLayout
        android:id="@+id/ime_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ime_header"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp">

            <ImageButton
                android:id="@+id/btn_switch_ime"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="前のキーボードに戻る"
                android:padding="10dp"
                android:src="@drawable/ic_language_24"
                android:tint="#0369A1" />

            <TextView
                android:id="@+id/text_ime_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="8dp"
                android:text="クリップボード"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/btn_quick_add"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="定型文を作成"
                android:padding="10dp"
                android:src="@drawable/ic_add_24"
                android:tint="#475569" />

            <ImageButton
                android:id="@+id/btn_close_keyboard"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="キーボードを閉じる"
                android:padding="10dp"
                android:src="@drawable/ic_keyboard_hide_24"
                android:tint="#475569" />
        </LinearLayout>

        <View
            android:id="@+id/header_shadow"
            android:layout_width="match_parent"
            android:layout_height="2dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_clips"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingVertical="4dp" />

        <TextView
            android:id="@+id/text_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="16dp"
            android:text="コピーしたテキストがここに並びます。\n右上の「＋」から定型文も追加できます。"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/overlay_quick_actions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="bottom"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/overlay_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_control_dock"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/overlay_preview_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:padding="8dp"
                android:textColor="#0F172A"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2064748B" />

            <LinearLayout
                android:id="@+id/action_toggle_pin"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp">
                <ImageView
                    android:id="@+id/action_pin_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_push_pin_16"
                    android:tint="#0369A1" />
                <TextView
                    android:id="@+id/action_pin_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="ピン留めする"
                    android:textColor="#0F172A"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_edit"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp">
                <ImageView
                    android:id="@+id/action_edit_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_edit_24"
                    android:tint="#475569" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="編集する"
                    android:textColor="#0F172A"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_delete"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp">
                <ImageView
                    android:id="@+id/action_delete_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_delete_24"
                    android:tint="#E11D48" />
                <TextView
                    android:id="@+id/action_delete_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="削除する"
                    android:textColor="#E11D48"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
