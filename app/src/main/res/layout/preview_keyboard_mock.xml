<?xml version="1.0" encoding="utf-8"?>
<!-- 実機のIME全体(244dp)をそのまま埋め込むと縦スクロール画面内で扱いづらいため、
     ヘッダー+サンプル行2つだけの縮小モックとして用意する。
     色を変更した瞬間にここへ反映することで「探索的な操作性」を実現する。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/preview_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/preview_header"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp">

        <ImageView
            android:id="@+id/preview_header_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_language_24" />

        <TextView
            android:id="@+id/preview_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="クリップボード"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/preview_header_close"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_keyboard_hide_24" />
    </LinearLayout>

    <View
        android:id="@+id/preview_header_shadow"
        android:layout_width="match_parent"
        android:layout_height="3dp" />

    <include
        android:id="@+id/preview_row1"
        layout="@layout/item_clip_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/preview_row2"
        layout="@layout/item_clip_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
